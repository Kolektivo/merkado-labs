NEXT_PUBLIC_SUPABASE_URL=
# Browser publishable key (anon). Used for Supabase Auth sessions and data access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Approved Supabase Auth callback origin, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Labs service role. Must target an approved non-production Labs
# project: active csaefdkpwukshtouyixg, alternative ewoxmzznkavapcxdporm, or
# the isolated wave6 fork ajbeqiwgpttpmzpqxepl.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=csaefdkpwukshtouyixg

# Server-only comma-separated allowlist of admin emails (normalized, lowercase).
# When set, admin access fails closed for any email not on the list.
# Required on the Vercel Production environment for defense in depth.
ADMIN_EMAILS=

# Shared host password for the hosted demo. Leave empty locally.
# Required on the Vercel Production environment. Never commit the real value.
# The hosted app fails closed at /enter: when configured, this pass is required
# before Supabase Auth sign-in; protected routes then require both.
LABS_DEMO_PASSWORD=

# Optional future public hosts. Leave empty to use working Labs routes.
# New tab is used only when these are absolute external URLs.
NEXT_PUBLIC_MERKADO_PAY_URL=
NEXT_PUBLIC_MERKADO_DIRECT_URL=

# Optimism Mainnet MerkadoRentOfferV1 contract address.
# Current deployed contract: 0x97439e4352b9428F56651be7DE95224B1c83b711
# Leave empty until the Product Lead approves local/hosted activation.
NEXT_PUBLIC_MERKADO_CONTRACT_ADDRESS=

# Legacy label for the Merkado operator address. The backend mint key below
# is the actual on-chain minter; this env is optional display only.
NEXT_PUBLIC_MERKADO_COMPANY_SAFE=

# Server-only Optimism Mainnet RPC for the server to read receipts and events.
# Defaults to https://mainnet.optimism.io when empty. Never expose to browser code.
MERKADO_RPC_URL=
# Server-only Optimism Mainnet key used after explicit Admin mint confirmation.
# Never commit or expose to browser code. Fund only with the approved gas budget.
MERKADO_MINTER_PRIVATE_KEY=
