NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Labs service role. Must target project csaefdkpwukshtouyixg only.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=csaefdkpwukshtouyixg

# Shared host password for the hosted demo. Leave empty locally.
# Required on the Vercel Production environment. Never commit the real value.
LABS_DEMO_PASSWORD=

# Optional future public hosts. Leave empty to use working Labs routes.
# New tab is used only when these are absolute external URLs.
NEXT_PUBLIC_MERKADO_PAY_URL=
NEXT_PUBLIC_MERKADO_DIRECT_URL=

# Demo payment network. Empty or base-sepolia is the Base testnet.
# Use a full key only. Short names such as base or op are ignored.
# Now: base-sepolia
# Later / real USDC (also unlocks Base Mainnet in Admin): base-mainnet
# Luis later: op-sepolia | op-mainnet still exist in the catalog but stay hidden.
NEXT_PUBLIC_PAY_NETWORK=base-sepolia
