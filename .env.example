NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only Labs service role. Must target project ewoxmzznkavapcxdporm only.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=ewoxmzznkavapcxdporm

# Shared host password for the hosted demo. Leave empty locally.
# Required on the Vercel Production environment. Never commit the real value.
LABS_DEMO_PASSWORD=

# Optional future public hosts. Leave empty to use working Labs routes.
# New tab is used only when these are absolute external URLs.
NEXT_PUBLIC_MERKADO_PAY_URL=
NEXT_PUBLIC_MERKADO_DIRECT_URL=

# Demo payment network. Empty or base-sepolia is the Base testnet.
# Use a full key only. Short names such as base or op are ignored.
# Now: base-sepolia
# Later / real USDC (also unlocks Base Mainnet in Admin): base-mainnet
# Optimism keys still exist in the catalog but stay hidden.
NEXT_PUBLIC_PAY_NETWORK=base-sepolia

# Base Sepolia MerkadoRentOfferV1 contract address.
# Empty until the contract is deployed and verified; surfaces then show a
# not-configured state. Never fake a transaction when this is empty.
NEXT_PUBLIC_MERKADO_CONTRACT_ADDRESS=

# Verified Base Sepolia company Safe that mints offer NFTs.
# Defaults to 0xfC6ec9718d89d4935594E7DB78399913071FcDc4 when empty.
NEXT_PUBLIC_MERKADO_COMPANY_SAFE=

# Server-only Base Sepolia RPC for the server to read receipts and events.
# Defaults to https://sepolia.base.org when empty. Never expose to browser code.
MERKADO_RPC_URL=