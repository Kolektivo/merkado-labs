NEXT_PUBLIC_SUPABASE_URL=
# Browser publishable key (anon). Used for Supabase Auth sessions and data access.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Approved Supabase Auth callback origin, for example http://localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only Labs service role. Must target project ewoxmzznkavapcxdporm only.
SUPABASE_SECRET_KEY=
SUPABASE_PROJECT_REF=ewoxmzznkavapcxdporm

# Server-only comma-separated allowlist of admin emails (normalized, lowercase).
# When set, admin access fails closed for any email not on the list.
# Required on the Vercel Production environment for defense in depth.
ADMIN_EMAILS=

# Shared host password for the hosted demo. Leave empty locally.
# Required on the Vercel Production environment. Never commit the real value.
# The hosted app fails closed at /enter: when configured, this pass is required
# before Supabase Auth sign-in; protected routes then require both.
LABS_DEMO_PASSWORD=

# Optional future public hosts. Leave empty to use working Labs routes.
# New tab is used only when these are absolute external URLs.
NEXT_PUBLIC_MERKADO_PAY_URL=
NEXT_PUBLIC_MERKADO_DIRECT_URL=

# Demo payment network. Empty or base-sepolia is the Base testnet.
# Use a full key only. Short names such as base or op are ignored.
# Now: base-sepolia
# Later / real USDC (also unlocks Base Mainnet in Admin): base-mainnet
# Optimism keys still exist in the catalog but stay hidden.
NEXT_PUBLIC_PAY_NETWORK=base-sepolia

# Base Sepolia MerkadoRentOfferV1 contract address.
# Empty until the contract is deployed and verified; surfaces then show a
# not-configured state. Never fake a transaction when this is empty.
NEXT_PUBLIC_MERKADO_CONTRACT_ADDRESS=

# Legacy label for the Merkado operator address. The backend mint key below
# is the actual on-chain minter; this env is optional display only.
NEXT_PUBLIC_MERKADO_COMPANY_SAFE=

# Server-only Base Sepolia RPC for the server to read receipts and events.
# Defaults to https://sepolia.base.org when empty. Never expose to browser code.
MERKADO_RPC_URL=
# Server-only Base Sepolia key that mints offer NFTs automatically after
# Admin approval. Testnet-only, never commit, never expose to browser code.
# Fund it with Base Sepolia ETH (it pays the mint gas).
MERKADO_MINTER_PRIVATE_KEY=

# Secret that protects the background mint sweep cron (/api/cron/mint).
# Set in the hosted environment; the cron sends it as the Authorization header.
CRON_SECRET=
