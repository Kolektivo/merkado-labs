NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional MapLibre style URL for production (e.g. MapTiler).
# Leave unset for local OpenStreetMap raster tiles.
NEXT_PUBLIC_MAP_STYLE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=

# Optional server-side reverse geocoding (disabled by default).
# Never expose these to the browser. Not used during page rendering.
REVERSE_GEOCODE_ENABLED=false
REVERSE_GEOCODE_ENDPOINT=
REVERSE_GEOCODE_API_KEY=
REVERSE_GEOCODE_MIN_INTERVAL_MS=1000

# Server-only OpenAI enrichment (never NEXT_PUBLIC_ and never commit real secrets).
# OpenAI calls run in Python (`scripts/run_ai_enrichment.py`), not in the browser.
# OPENAI_ENRICHMENT_MODEL is required — no silent default.
OPENAI_API_KEY=
OPENAI_ENRICHMENT_MODEL=
OPENAI_ENRICHMENT_REASONING_EFFORT=
OPENAI_ENRICHMENT_MAX_OUTPUT_TOKENS=
OPENAI_ENRICHMENT_BATCH_SIZE=3
# Shared Labs admin gate only; this is not user authentication. Never commit a value.
LABS_ADMIN_SECRET=

# Server-only Labs service role for AI review, jobs, and search-request preview (never NEXT_PUBLIC_).
# Must target project csaefdkpwukshtouyixg only.
SUPABASE_SECRET_KEY=
